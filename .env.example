# Server port (default 3000)
PORT=3000

# SQLite file path (default data/syncsofa.db). The directory is created
# automatically. Use :memory: for an ephemeral, non-persistent database.
DB_PATH=data/syncsofa.db

# Optional TURN server. Without these, WebRTC calls use STUN only, which
# works fine on most home networks but can fail on restrictive/corporate/
# mobile networks. All three must be set together, or none are used.
#
# Free options:
#  - Cloudflare Realtime TURN: dashboard.cloudflare.com > Calls > TURN,
#    create a key, use its TURN URL/username/credential below.
#  - metered.ca Open Relay: metered.ca/tools/openrelay (free tier).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
